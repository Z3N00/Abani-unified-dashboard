# Public Supabase project URL. Browser access must still be protected by RLS
# and authenticated server routes.
NEXT_PUBLIC_SUPABASE_URL=

# Server-only Supabase administrator key. Never expose this to client code.
SUPABASE_SERVICE_ROLE_KEY=

# Stable, high-entropy secret used to sign dashboard sessions.
APP_SESSION_SECRET=

# SellerCloud server-side integration.
SELLERCLOUD_USER=
SELLERCLOUD_PASS=
SELLERCLOUD_COMPANY_ID=204
SELLERCLOUD_BASE_URL=https://aq.api.sellercloud.com/rest
SELLERCLOUD_INVENTORY_BATCH_PAGES=10

# ShipsGo embed-scoped token. This appears in the browser iframe URL, so do
# not use a full-access ShipsGo API credential here.
SHIPSGO_EMBED_TOKEN=

# Used by Vercel to authenticate scheduled inventory-sync requests.
CRON_SECRET=

# Public URL placed in overseas documentation invitation links.
APP_BASE_URL=http://localhost:3000

# Gmail SMTP used by the admin-reviewed Email Queue. Use a Google app
# password, never the mailbox's normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=po@abanirugs.com
SMTP_PASSWORD=
SMTP_FROM=po@abanirugs.com

# Server-only Slack Incoming Webhook used by the container detail action.
# Never prefix this with NEXT_PUBLIC_ or expose it to browser code.
SLACK_WEBHOOK_URL=

# Preferred warehouse-aware Slack Web API integration. The bot must have
# chat:write and access to each configured private channel.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_CONTAINER_TRACKER=
SLACK_CHANNEL_JAX_WH4=
SLACK_CHANNEL_PA_WH9=
SLACK_CHANNEL_TX_WH5=
